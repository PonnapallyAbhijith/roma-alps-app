rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in [
          'abhi14346@gmail.com',
          'REPLACE_WITH_WIFES_EMAIL'
        ];
    }

    // Day-plan edits (the "Add plan / Edit plan" buttons).
    match /plans/{planId} {
      allow read, write: if isAllowed();
    }
    // Which Drive folder is shared storage for attachments (id + name).
    match /config/{doc} {
      allow read, write: if isAllowed();
    }
    // Shared, editable checklists (packing, and any custom ones).
    match /checklists/{listId} {
      allow read, write: if isAllowed();
    }
    // Shared, multi-currency trip expenses.
    match /expenses/{expenseId} {
      allow read, write: if isAllowed();
    }
  }
}
